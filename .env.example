# Exemplo de variáveis de ambiente do planejamento-service.
#
# Copie para ".env" (ou exporte no ambiente) e ajuste por ambiente.
# Valores abaixo servem para desenvolvimento local com o docker-compose.dev.yml.
#
# Uso local (ambiente limpo):
#   docker compose -f docker-compose.dev.yml up -d
#   cp .env.example .env
#   set -a && . ./.env && set +a
#   bash ./mvnw spring-boot:run
#
# Detalhes de cada variável em docs/ENVIRONMENT.md.

# Perfil de integração: desabilita o auto-processamento local de agendamentos
# (os comandos chegam pelo RabbitMQ). Em produção use SPRING_PROFILES_ACTIVE=integration.
SPRING_PROFILES_ACTIVE=integration

# Banco (Postgres) — o serviço é o único dono do schema "agendamento".
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/planejamento?sslmode=disable
SPRING_DATASOURCE_USERNAME=planejamento
SPRING_DATASOURCE_PASSWORD=planejamento
# O application.properties força sslmode=require; localmente sobrescrevemos.
SPRING_DATASOURCE_HIKARI_DATA_SOURCE_PROPERTIES_SSLMODE=disable
# Necessário para o Spring (placeholder em application.properties).
SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ (topologia do CONTRACT.md §1)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=planejamento
RABBITMQ_PASS=planejamento

# Autenticação: configure JWT_SECRET (HS256, BASE64URL, igual ao busco-api)
# OU JWT_ISSUER (resource server OAuth2). O exemplo abaixo é um segredo de
# desenvolvimento — troque em produção.
JWT_SECRET=cGxhbmVqYW1lbnRvLXNlcnZpY2UtZGV2LXNlY3JldC0zMmJ5dGVzISE
JWT_ISSUER=

# Tenant fixo da instalação (fallback quando token/mensagem não traz tenant_id).
TENANT_ID=00000000-0000-0000-0000-000000000001
